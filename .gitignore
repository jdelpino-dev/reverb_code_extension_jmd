*.gguf

# Experiment tracking
wandb/
mlruns/
mlartifacts/

# Ignore all data contents (not the directory itself, so negations work)
data/**
artifacts/**
outputs/**
models/**

# But track directories and .gitkeep files to preserve structure
!data/**/
!data/**/.gitkeep
!artifacts/**/
!artifacts/**/.gitkeep
!outputs/**/
!outputs/**/.gitkeep
!models/**/
!models/**/.gitkeep

# Secrets and environment
.env
.env.*
!.env.example
.secrets/
*.pem
*.key
**/.env
**/.env.*
**/!.env.example
**/.secrets/
**/*.pem
**/*.key

# Snyk workaround (generated by poe snyk_check)
snyk_requirements.txt
.agents/
/data

# Temporary files and folders
tmp/*
temp/*
*.tmp
*.temp
