.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Rails dependencies
**/vendor/bundle/**
**/vendor/**
**/bundle/**

# Node & pnpm
**/node_modules/**

# Jupyter
.ipynb_checkpoints/

# Editors
.idea/

