{
  "name": "Gear Garage (Python)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [
    5000
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "FLASK_APP": "app",
    "FLASK_DEBUG": "1"
  },
  "postCreateCommand": "pip install uv && uv sync --dev",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-vsliveshare.vsliveshare"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
